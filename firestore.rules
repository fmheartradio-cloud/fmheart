rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primary owner: fmheartradio@gmail.com
    // Add more emails to isAdmin() as needed
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'fmheartradio@gmail.com'
        ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /articles/{articleId} {
      // Public can read published articles
      allow read: if resource == null
        || resource.data.status == 'published'
        || isAdmin();

      allow create, delete: if isAdmin();

      // Admin full update, or public +1 view counter only
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.get('views', 0) + 1
        );
    }

    // Admin-deleted / uncovered source URLs — newsbot must never re-ingest these.
    match /newsbot_blocked/{blockId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
