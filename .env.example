# FM Heart — copy to .env.local after creating NEW Firebase + AdSense accounts

# ── Firebase (new Google Cloud / Firebase project) ──────────────────────────
# Console: https://console.firebase.google.com → Add project → "fmheart"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fm-heart-eghluo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fm-heart-eghluo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fm-heart-eghluo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Native Firestore DB id (required for this project — not "(default)")
NEXT_PUBLIC_FIRESTORE_DB_ID=fmheart

# ── News bot (Vercel Cron + optional local Python) ─────────────────────────
# Paste Firebase service account JSON as a single-line / raw string (never commit)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIRESTORE_DB_ID=fmheart
# Protect /api/cron/newsbot — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# ── Google AdSense (new / existing publisher) ───────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=

# ── Optional SEO / Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fmheart.lk

# ── Live radio / FFT spectrum ───────────────────────────────────────────────
# Real FFT needs a CORS proxy (Icecast host does not send ACAO).
# Default: /api/radio-stream on Vercel (works, but counts as bandwidth).
# Cheapest: Cloudflare Worker (cloudflare/ folder) — zero egress fees:
#   NEXT_PUBLIC_STREAM_PROXY_URL=https://fmheart-radio-proxy.<you>.workers.dev
# Emergency cost cut (direct Icecast + simulated bars, no proxy bytes):
#   NEXT_PUBLIC_REALTIME_SPECTRUM=false
# NEXT_PUBLIC_STREAM_PROXY_URL=
# NEXT_PUBLIC_REALTIME_SPECTRUM=true

# ── Facebook Page auto-post (Meta Graph API) ───────────────────────────────
# From Graph API Explorer → GET me/accounts → use that Page's id + access_token
# FACEBOOK_PAGE_ID=1243987532130728
# FACEBOOK_PAGE_ACCESS_TOKEN=
# Set to false to disable without removing tokens
# FACEBOOK_AUTO_POST=true
# Newsbot → Facebook (default on when FACEBOOK_AUTO_POST is configured)
# FACEBOOK_NEWSBOT_AUTO_POST=true
# Max Facebook posts per newsbot cron run (default 5, max 20)
# FACEBOOK_NEWSBOT_MAX_PER_RUN=5

# ── Admin access (comma-separated). Primary owner is always allowed in code:
# fmheartradio@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=fmheartradio@gmail.com
