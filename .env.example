# FM Heart — copy to .env.local after creating NEW Firebase + AdSense accounts

# ── Firebase (new Google Cloud / Firebase project) ──────────────────────────
# Console: https://console.firebase.google.com → Add project → "fmheart"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fm-heart-eghluo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fm-heart-eghluo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fm-heart-eghluo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Native Firestore DB id (required for this project — not "(default)")
NEXT_PUBLIC_FIRESTORE_DB_ID=fmheart

# ── Google AdSense (new / existing publisher) ───────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=

# ── Optional SEO / Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fmheart.lk

# ── Admin access (comma-separated). Primary owner is always allowed in code:
# fmheartradio@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=fmheartradio@gmail.com
